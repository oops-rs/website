---
const pathname = Astro.url.pathname;
const links = [
  { href: "/projects", label: "Projects", external: false },
  { href: "https://github.com/oops-rs", label: "GitHub", external: true }
];
---

<header class="site-header">
  <a class="brand" href="/">
    <img src="/oops-rs-mark.png" alt="" width="32" height="32" />
    <span>oops-rs</span>
  </a>

  <nav aria-label="Primary">
    {
      links.map((link) => {
        const active = !link.external && pathname.startsWith(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    max-width: var(--col-wide);
    margin: 0 auto;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand img {
    width: 32px;
    height: 32px;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    transition: color 120ms var(--ease);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
</style>
