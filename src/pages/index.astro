---
import FooterCta from "../components/FooterCta.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const title = "oops-rs — a joyful Rust tool universe";
const description =
  "Official website for the oops-rs GitHub organization: fast Rust tools for code intelligence, agents, localization, sandboxes, and the small infrastructure that makes real systems less miserable.";

const pillars = [
  {
    number: "01",
    title: "Tools that face real workflows",
    body: "Built for use, not pitch decks — CI, code graphs, asset parsing, translators, gatekeepers, runtimes."
  },
  {
    number: "02",
    title: "Rust as the internal skeleton",
    body: "Performance, control, strong types, and fewer runtime surprises. The surface can breathe because the internals are grounded."
  },
  {
    number: "03",
    title: "Small enough to be human",
    body: "Even the weirder tools still explain themselves. You should land here curious, not confused."
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="page-shell">
    <SiteHeader />

    <main>
      <section class="hero">
        <p class="eyebrow fade-in">The oops-rs organization</p>
        <h1 class="hero-title fade-in delay-1">
          Rust tools with <em>confetti</em> in their bloodstream.
        </h1>
        <p class="hero__lede fade-in delay-2">
          Sharp instruments for agents, code, localization, sandboxes, and the small
          infrastructure spells that make real systems less miserable.
        </p>
        <div class="hero__actions fade-in delay-2">
          <a class="button button--solid" href="/projects">
            Browse projects <span class="arrow">→</span>
          </a>
          <a class="button button--ghost" href="https://github.com/oops-rs" target="_blank" rel="noreferrer">
            Open GitHub <span class="arrow">↗</span>
          </a>
        </div>
      </section>

      <section class="manifesto">
        <p class="eyebrow">The feeling</p>
        <h2>This is not a normal official website.</h2>
        <p>
          It is a bright machine hall. A launch bay. A place for tools that do serious work
          without needing to dress like accountants.
        </p>
        <p>
          The point is to let the energy of the tools show: exacting internals, playful
          surfaces, and a bias toward shipping things that genuinely help.
        </p>
      </section>

      <section class="constellation">
        <div class="section-heading">
          <p class="eyebrow">Projects</p>
          <h2>Everything currently in orbit.</h2>
        </div>

        <div class="project-list">
          {
            projects.map((project) => (
              <a
                href={`/projects/${project.slug}`}
                class:list={["project-row", project.status === "private" && "project-row--private"]}
              >
                <span class="project-row__name">{project.name}</span>
                <span class="project-row__tagline">{project.tagline}</span>
                <span class="project-row__meta">
                  <span class="project-row__status">{project.status}</span>
                  <span class="arrow">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="pillars-section">
        <div class="section-heading">
          <p class="eyebrow">What lives here</p>
          <h2>Code intelligence, agent runtimes, localization machinery, boundary magic.</h2>
        </div>
        <div class="pillars">
          {
            pillars.map((pillar) => (
              <article>
                <span class="pillar__number">{pillar.number}</span>
                <div>
                  <h3>{pillar.title}</h3>
                  <p>{pillar.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <FooterCta />
    </main>
  </div>
</BaseLayout>
