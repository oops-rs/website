---
import FooterCta from "../components/FooterCta.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Spectrum from "../components/Spectrum.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { families } from "../data/families";
import { projects } from "../data/projects";

const title = "oops-rs — Rust tools for agents, code, and the plumbing between";
const description =
  "The oops-rs GitHub organization: Rust tools for coding agents, code intelligence, AI gateways, sandboxes, localization, and Apple tooling.";

const principles = [
  {
    title: "Built for a real workflow",
    body: "Every project started because something in CI, a codebase, or an agent loop was slow, brittle, or missing."
  },
  {
    title: "Rust underneath",
    body: "Strong types and predictable performance in the core, so the surface can stay small and friendly."
  },
  {
    title: "Small enough to explain",
    body: "If a tool can't say what it does in one sentence, it isn't finished yet."
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="page-shell">
    <SiteHeader />

    <main>
      <section class="hero">
        <h1>Rust tools for coding agents, codebases, and the plumbing between them.</h1>
        <p>
          {projects.length} projects across five families, from agent runtimes and code graphs to
          AI gateways and Apple asset tooling. Pick a color to jump in.
        </p>
      </section>

      <Spectrum />

      <section class="stack-section">
        <div class="section-heading">
          <h2>The families</h2>
        </div>
        <ul class="families">
          {
            families.map((family) => (
              <li>
                <h3>
                  <a href={`/projects#${family.id}`}>{family.name}</a>
                </h3>
                <p>{family.blurb}</p>
                <ul class="families__members">
                  {family.projects.map((project) => (
                    <li>
                      <a
                        class="project-name"
                        href={`/projects/${project.slug}`}
                        style={`--swatch: ${project.primaryColor}`}
                      >
                        {project.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="stack-section">
        <div class="section-heading">
          <h2>How we build</h2>
        </div>
        <ul class="principles">
          {
            principles.map((principle) => (
              <li>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <FooterCta />
    </main>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: clamp(64px, 11vw, 128px) 0 clamp(40px, 6vw, 64px);
    max-width: 780px;
  }

  .hero h1 {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .hero p {
    margin-top: 24px;
    max-width: 52ch;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .families {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    column-gap: clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--line-strong);
  }

  .families > li {
    padding: 24px 0 28px;
    border-bottom: 1px solid var(--line);
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .families h3 {
    font-size: var(--step-1);
  }

  .families h3 a:hover {
    color: var(--gold);
  }

  .families > li > p {
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  .families__members {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 10px;
  }

  .families__members a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.9375rem;
  }

  .families__members a::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--swatch);
  }

  .families__members a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(24px, 4vw, 48px);
  }

  .principles h3 {
    font-size: var(--step-1);
    margin-bottom: 8px;
  }

  .principles p {
    color: var(--ink-muted);
  }
</style>
