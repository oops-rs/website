---
import FooterCta from "../../components/FooterCta.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const title = `${project.name} — oops-rs`;
const description = project.longDescription;
---

<BaseLayout title={title} description={description}>
  <div class="page-shell">
    <SiteHeader />

    <main>
      <section class="detail-hero">
        <p class="eyebrow fade-in">Project · {project.status}</p>
        <h1 class="fade-in delay-1">{project.name}</h1>
        <p class="detail-hero__tagline fade-in delay-1">{project.tagline}</p>
        <p class="detail-hero__body fade-in delay-2">{project.longDescription}</p>
        <div class="detail-hero__actions fade-in delay-2">
          <a class="button button--solid" href={project.repoUrl} target="_blank" rel="noreferrer">
            Open repository <span class="arrow">↗</span>
          </a>
          <a class="button button--ghost" href="/projects">
            <span class="arrow" style="transform: rotate(180deg);">→</span> All projects
          </a>
        </div>
      </section>

      <div class="detail-sections">
        <section>
          <h2>Capabilities</h2>
          <ul>
            {project.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </section>

        <section>
          <h2>Try it</h2>
          <ul class="command-list">
            {project.commands.map((command) => <li>{command}</li>)}
          </ul>
        </section>

        <section>
          <h2>Identity</h2>
          <ul>
            <li>{project.motif}</li>
            <li>{project.orbitLabel}</li>
            <li>Status · {project.status}</li>
          </ul>
        </section>
      </div>

      <FooterCta />
    </main>
  </div>
</BaseLayout>
