---
import FooterCta from "../../components/FooterCta.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";

const title = "Projects — oops-rs";
const description = "The tools and experiments currently orbiting the oops-rs universe.";
---

<BaseLayout title={title} description={description}>
  <div class="page-shell">
    <SiteHeader />
    <main>
      <section class="subpage-hero">
        <p class="eyebrow fade-in">Directory</p>
        <h1 class="fade-in delay-1">Projects</h1>
        <p class="fade-in delay-2">
          Each project solves a concrete problem. Each one still gets to be a little theatrical.
        </p>
      </section>

      <section>
        <div class="project-list">
          {
            projects.map((project) => (
              <a
                href={`/projects/${project.slug}`}
                class:list={["project-row", project.status === "private" && "project-row--private"]}
              >
                <span class="project-row__name">{project.name}</span>
                <span class="project-row__tagline">{project.tagline}</span>
                <span class="project-row__meta">
                  <span class="project-row__status">{project.status}</span>
                  <span class="arrow">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <FooterCta />
    </main>
  </div>
</BaseLayout>
